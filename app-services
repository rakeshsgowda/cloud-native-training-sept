# ==========================================
# 1. SHARED SECRET FOR SERVICES
# ==========================================
apiVersion: v1
kind: Secret
metadata:
  name: app-secret
  namespace: retail-banking
type: Opaque
stringData:
  DB_USERNAME: "banking"
  DB_PASSWORD: "banking"
---
# ==========================================
# 2. CUSTOMER SERVICE (Port 8081 -> customer_db)
# ==========================================
apiVersion: apps/v1
kind: Deployment
metadata:
  name: customer-service
  namespace: retail-banking
spec:
  replicas: 1
  selector:
    matchLabels:
      app: customer-service
  template:
    metadata:
      labels:
        app: customer-service
    spec:
      containers:
        - name: customer-service
          image: solo01akslab.azurecr.io/customer-service:t01-v1
          ports:
            - containerPort: 8081
          env:
            - name: DB_URL
              value: "jdbc:postgresql://postgres.retail-banking.svc.cluster.local:5432/customer_db"
            - name: DB_USERNAME
              valueFrom:
                secretKeyRef:
                  name: app-secret
                  key: DB_USERNAME
            - name: DB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: app-secret
                  key: DB_PASSWORD
          resources:
            requests:
              memory: "256Mi"
              cpu: "250m"
            limits:
              memory: "512Mi"
              cpu: "500m"
          readinessProbe:
            httpGet:
              path: /actuator/health
              port: 8081
            initialDelaySeconds: 20
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /actuator/health
              port: 8081
            initialDelaySeconds: 40
            periodSeconds: 15
---
apiVersion: v1
kind: Service
metadata:
  name: customer-service
  namespace: retail-banking
spec:
  selector:
    app: customer-service
  ports:
    - port: 8081
      targetPort: 8081
  type: ClusterIP
---
# ==========================================
# 3. ACCOUNT SERVICE (Port 8082 -> account_db)
# ==========================================
apiVersion: apps/v1
kind: Deployment
metadata:
  name: account-service
  namespace: retail-banking
spec:
  replicas: 1
  selector:
    matchLabels:
      app: account-service
  template:
    metadata:
      labels:
        app: account-service
    spec:
      containers:
        - name: account-service
          image: solo01akslab.azurecr.io/account-service:t01-v1
          ports:
            - containerPort: 8082
          env:
            - name: DB_URL
              value: "jdbc:postgresql://postgres.retail-banking.svc.cluster.local:5432/account_db"
            - name: CUSTOMER_SERVICE_URL
              value: "http://customer-service.retail-banking.svc.cluster.local:8081"
            - name: DB_USERNAME
              valueFrom:
                secretKeyRef:
                  name: app-secret
                  key: DB_USERNAME
            - name: DB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: app-secret
                  key: DB_PASSWORD
          resources:
            requests:
              memory: "256Mi"
              cpu: "250m"
            limits:
              memory: "512Mi"
              cpu: "500m"
          readinessProbe:
            httpGet:
              path: /actuator/health
              port: 8082
            initialDelaySeconds: 20
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /actuator/health
              port: 8082
            initialDelaySeconds: 40
            periodSeconds: 15
---
apiVersion: v1
kind: Service
metadata:
  name: account-service
  namespace: retail-banking
spec:
  selector:
    app: account-service
  ports:
    - port: 8082
      targetPort: 8082
  type: ClusterIP
---
# ==========================================
# 4. FRONTEND SERVICE (Port 5173 -> Container Port 80)
# ==========================================
apiVersion: apps/v1
kind: Deployment
metadata:
  name: frontend
  namespace: retail-banking
spec:
  replicas: 1
  selector:
    matchLabels:
      app: frontend
  template:
    metadata:
      labels:
        app: frontend
    spec:
      containers:
        - name: frontend
          image: solo01akslab.azurecr.io/frontend:t01-v1
          ports:
            - containerPort: 80
          resources:
            requests:
              memory: "128Mi"
              cpu: "100m"
            limits:
              memory: "256Mi"
              cpu: "250m"
---
apiVersion: v1
kind: Service
metadata:
  name: frontend
  namespace: retail-banking
spec:
  selector:
    app: frontend
  ports:
    - port: 5173
      targetPort: 80
  type: LoadBalancer
