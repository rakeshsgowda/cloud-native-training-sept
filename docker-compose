services:

  # ============================================================
  # PostgreSQL Database
  # ============================================================
  postgres:
    image: postgres:16
    container_name: postgres

    environment:
      POSTGRES_DB: customer_db
      POSTGRES_USER: banking
      POSTGRES_PASSWORD: banking

    ports:
      - "5432:5432"

    volumes:
      - postgres-data:/var/lib/postgresql/data
      - ./docker/postgres/init:/docker-entrypoint-initdb.d

    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U banking -d customer_db"]
      interval: 10s
      timeout: 5s
      retries: 5

    networks:
      - banking-network


  # ============================================================
  # Customer Service
  # ============================================================
  customer-service:
    build:
      context: ./backend/customer-service

    container_name: customer-service

    environment:
      DB_URL: jdbc:postgresql://postgres:5432/customer_db
      DB_USERNAME: banking
      DB_PASSWORD: banking

    ports:
      - "8081:8081"

    depends_on:
      postgres:
        condition: service_healthy

    networks:
      - banking-network


  # ============================================================
  # Account Service
  # ============================================================
  account-service:
    build:
      context: ./backend/account-service

    container_name: account-service

    environment:
      DB_URL: jdbc:postgresql://postgres:5432/account_db
      DB_USERNAME: banking
      DB_PASSWORD: banking
      CUSTOMER_SERVICE_URL: http://customer-service:8081

    ports:
      - "8082:8082"

    depends_on:
      postgres:
        condition: service_healthy
      customer-service:
        condition: service_started

    networks:
      - banking-network


  # ============================================================
  # React Frontend - Nginx Production Container
  # ============================================================
  frontend:
    build:
      context: ./frontend

    container_name: frontend

    ports:
      - "5173:80"

    depends_on:
      customer-service:
        condition: service_started
      account-service:
        condition: service_started

    networks:
      - banking-network


# ==============================================================
# Persistent PostgreSQL Volume
# ==============================================================
volumes:
  postgres-data:


# ==============================================================
# Existing Docker Network
# ==============================================================
networks:
  banking-network:
    external: true
